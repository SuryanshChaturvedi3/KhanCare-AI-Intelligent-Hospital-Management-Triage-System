# ============================================
# Docker Compose Environment Variables
# ============================================
# HOW TO USE:
# 1. Copy this file: cp .env.docker .env
# 2. Fill in your real values below
# 3. Run: docker compose up --build
#
# WHY a separate file?
# Docker Compose reads from .env in the same directory automatically.
# This file is the TEMPLATE — you copy it and fill in real secrets.
# The actual .env (with real keys) is gitignored for security.

# MongoDB Atlas connection string
# Get from: https://cloud.mongodb.com → Connect → Drivers → Copy string
MONGO_URI=mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/khan_care_db?retryWrites=true&w=majority

# JWT Secret — any long random string (32+ characters)
# Generate: openssl rand -base64 32
JWT_SECRET=change-this-to-a-very-long-random-string-at-least-32-chars

# Google Gemini API Key
# Get from: https://aistudio.google.com/apikey
GOOGLE_API_KEY=your-gemini-api-key-here

# OpenAI API Key (for embeddings)
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-api-key-here

# MongoDB URL for AI Agent (LangGraph checkpointer)
# Can be same as MONGO_URI, or separate database
MONGO_URL=mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/khan_care_db?retryWrites=true&w=majority
